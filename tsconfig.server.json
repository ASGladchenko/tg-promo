{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "allowJs": false,
    "jsx": "preserve"
  },
  "include": ["src/server/**/*.ts", "src/backend/**/*.ts"],
  "exclude": ["node_modules"]
}
