# ========================
# Frontend (Vite / public)
# ========================
# Public bot username (without @). Used to build fallback share URL if VITE_TELEGRAM_SHARE_URL is empty.
VITE_TELEGRAM_BOT_USERNAME=your_bot_username

# Public channel URL for UI actions (optional, keep empty if not used now).
VITE_TELEGRAM_CHANNEL_URL=https://t.me/your_channel

# Public direct URL to launch Mini App (preferred).
VITE_TELEGRAM_SHARE_URL=https://t.me/your_bot_username?startapp=play

# Public backend base URL. Leave empty locally when using Vite proxy, set in Vercel for production.
VITE_API_BASE_URL=

# Public external brand site URL (optional).
VITE_BRAND_SITE_URL=https://1mlnbet.com/


# ======================
# Backend (Nest / secret)
# ======================
# Telegram Bot Token (secret).
TELEGRAM_BOT_TOKEN=123456:ABCDEF

# Session signing secret (secret). Use a long random value in production.
APP_SESSION_SECRET=replace_with_long_random_secret

# Cookie SameSite policy: lax | strict | none
# For frontend and backend on different domains use: none
APP_SESSION_COOKIE_SAME_SITE=lax

# Channel ID for getChatMember check: @channel_username or numeric -100...
TELEGRAM_CHANNEL_ID=@your_channel

# Widget auth payload max age in seconds.
TELEGRAM_WIDGET_MAX_AGE_SECONDS=300

# Allowed frontend origins for CORS (comma-separated if multiple).
FRONTEND_ORIGIN=http://localhost:5173

# Backend port for local/dev run.
PORT=4000
